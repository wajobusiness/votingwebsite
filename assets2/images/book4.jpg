<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 600" width="400" height="600">
  <defs>
    <linearGradient id="bg4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#141108"/>
      <stop offset="50%" stop-color="#2d220a"/>
      <stop offset="100%" stop-color="#0d0a03"/>
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE066"/>
      <stop offset="50%" stop-color="#D4AF37"/>
      <stop offset="100%" stop-color="#AA8010"/>
    </linearGradient>
  </defs>
  <rect width="400" height="600" rx="12" fill="url(#bg4)"/>
  <rect x="15" y="15" width="370" height="570" rx="8" fill="none" stroke="url(#gold)" stroke-width="2" opacity="0.6"/>
  <rect x="25" y="25" width="350" height="550" rx="6" fill="none" stroke="url(#gold)" stroke-width="1" opacity="0.3"/>

  <text x="200" y="145" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="34" font-weight="900" fill="url(#gold)" text-anchor="middle">✦</text>

  <text x="200" y="280" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="26" font-weight="900" fill="url(#gold)" text-anchor="middle">THE MODEL’S</text>
  <text x="200" y="325" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="30" font-weight="900" fill="#FFFFFF" text-anchor="middle">PLAYBOOK</text>
  
  <text x="200" y="375" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="13" font-weight="600" fill="#E2E8F0" text-anchor="middle">High-Fashion Posing &amp; Portfolio Secrets</text>
  <line x1="140" y1="405" x2="260" y2="405" stroke="url(#gold)" stroke-width="2"/>

  <text x="200" y="440" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="11" fill="#94A3B8" text-anchor="middle">Geometric Angles • Runway Pacing • Agency Scouting</text>

  <text x="200" y="520" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="12" font-weight="700" fill="url(#gold)" text-anchor="middle" letter-spacing="1">ELENA ROSTOVA &amp; FASHION GUILD</text>
</svg>
