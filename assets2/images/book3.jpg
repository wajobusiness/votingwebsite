<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 600" width="400" height="600">
  <defs>
    <linearGradient id="bg3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#180c1e"/>
      <stop offset="50%" stop-color="#3b1347"/>
      <stop offset="100%" stop-color="#0c0410"/>
    </linearGradient>
    <linearGradient id="rose" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e"/>
      <stop offset="100%" stop-color="#be123c"/>
    </linearGradient>
  </defs>
  <rect width="400" height="600" rx="12" fill="url(#bg3)"/>
  <rect x="15" y="15" width="370" height="570" rx="8" fill="none" stroke="url(#rose)" stroke-width="2" opacity="0.6"/>
  <rect x="25" y="25" width="350" height="550" rx="6" fill="none" stroke="url(#rose)" stroke-width="1" opacity="0.3"/>

  <text x="200" y="145" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="36" font-weight="900" fill="#f43f5e" text-anchor="middle">⚡</text>

  <text x="200" y="280" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="28" font-weight="900" fill="#f43f5e" text-anchor="middle">VIRAL</text>
  <text x="200" y="325" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="28" font-weight="900" fill="#FFFFFF" text-anchor="middle">MOBILIZATION</text>
  
  <text x="200" y="375" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="13" font-weight="600" fill="#FDA4AF" text-anchor="middle">Social Media Growth for Contestants</text>
  <line x1="140" y1="405" x2="260" y2="405" stroke="url(#rose)" stroke-width="2"/>

  <text x="200" y="440" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="11" fill="#94A3B8" text-anchor="middle">Shorts &amp; Reels • Broadcast Groups • Rapid Voting</text>

  <text x="200" y="520" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="12" font-weight="700" fill="#f43f5e" text-anchor="middle" letter-spacing="1">DAVID O. VANCE</text>
</svg>
