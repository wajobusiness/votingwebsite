<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 600" width="400" height="600">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="50%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <linearGradient id="cyan" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE066"/>
      <stop offset="50%" stop-color="#D4AF37"/>
      <stop offset="100%" stop-color="#AA8010"/>
    </linearGradient>
  </defs>
  <rect width="400" height="600" rx="12" fill="url(#bg2)"/>
  <rect x="15" y="15" width="370" height="570" rx="8" fill="none" stroke="url(#cyan)" stroke-width="2" opacity="0.6"/>
  <rect x="25" y="25" width="350" height="550" rx="6" fill="none" stroke="url(#cyan)" stroke-width="1" opacity="0.3"/>

  <circle cx="200" cy="140" r="45" fill="url(#cyan)" opacity="0.15"/>
  <circle cx="200" cy="140" r="30" fill="none" stroke="url(#cyan)" stroke-width="2"/>
  <text x="200" y="146" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="20" font-weight="900" fill="#38bdf8" text-anchor="middle">★</text>

  <text x="200" y="280" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="28" font-weight="900" fill="#38bdf8" text-anchor="middle">UNSTOPPABLE</text>
  <text x="200" y="325" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="28" font-weight="900" fill="#FFFFFF" text-anchor="middle">GRACE</text>
  
  <text x="200" y="375" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="13" font-weight="600" fill="#94A3B8" text-anchor="middle">High-Impact Personal Branding &amp; Charisma</text>
  <line x1="140" y1="405" x2="260" y2="405" stroke="url(#cyan)" stroke-width="2"/>

  <text x="200" y="440" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="11" fill="#64748B" text-anchor="middle">Authentic Identity • Sponsorship • Leadership</text>

  <text x="200" y="520" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="12" font-weight="700" fill="#38bdf8" text-anchor="middle" letter-spacing="1">DR. SOPHIA ADELEKE</text>
</svg>
